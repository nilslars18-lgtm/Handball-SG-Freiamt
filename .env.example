# Kopiere diese Datei zu ".env" und trage deine Werte ein
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./handball.db
GOOGLE_MAPS_API_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
TEAM_NAME=SG Freiamt PLUS

# Feature 2: ab wie vielen Tagen vor dem Spiel darf aufgeboten werden
AUFGEBOT_DAYS_BEFORE=7

# Feature 3: wie viele Minuten vor Spielbeginn man in der Halle sein soll
ARRIVAL_BUFFER_MINUTES=120

# Feature 4: Essen-Umfrage
POLL_OPEN_WEEKDAY=3
POLL_OPEN_HOUR=14
POLL_OPEN_MINUTE=0
POLL_CLOSE_MINUTES_BEFORE_GAME=30
POLL_DEFAULT_OPTIONS=Pizza,Asiatisch,Burger,Kebab,Sonstiges,komme nicht mit
POLL_SKIP_OPTION=komme nicht mit
GAME_DEFAULT_DURATION_MINUTES=90

# Beschwerden gegen Bussen: Gebuehr in CHF, die beim Einreichen sofort als
# zusaetzliche Busse anfaellt (wird bei angenommener Beschwerde wieder geloescht)
COMPLAINT_FEE=5
